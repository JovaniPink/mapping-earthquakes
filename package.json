{
  "name": "leaflet-basic-map",
  "version": "1.0.0",
  "description": "Interactive Earthquake Mapping using GeoJSON data from earthquake.usgs.gov.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JovaniPink/mapping-earthquakes"
  },
  "homepage": "https://github.com/JovaniPink/mapping-earthquakes#readme",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "parcel index.html",
    "build": "parcel build index.html --dist-dir dist --public-url ./",
    "format:check": "prettier --check .github/workflows/api.yml index.html static/js/app.js static/scss/app.scss",
    "test": "npm run format:check && npm run build"
  },
  "keywords": [
    "bootstrap",
    "sass",
    "javascript",
    "jQuery",
    "leaflet",
    "mapbox",
    "dashboard"
  ],
  "author": "Jovani Pink",
  "license": "MIT",
  "dependencies": {
    "bootstrap": "5.3.8",
    "jquery": "3.7.1",
    "jquery.easing": "1.4.1",
    "leaflet": "1.9.4",
    "leaflet-draw": "1.0.4",
    "postcss": "8.5.25"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "parcel": "2.16.4",
    "prettier": "3.9.6",
    "sass": "1.102.0"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
