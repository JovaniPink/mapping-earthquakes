{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "playwright.config.mjs",
    "scripts/**/*.mjs",
    "static/js/**/*.js",
    "tests/**/*.mjs",
    "types/**/*.d.ts"
  ]
}
